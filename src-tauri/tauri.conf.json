{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portside",
  "version": "0.2.0",
  "identifier": "app.portside.dev",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:1420", "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build" },
  "app": { "windows": [{ "title": "Portside", "width": 1100, "height": 700 }] },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "./windows/prereq-hooks.nsh"
      }
    }
  }
}
